    "subject_role": "executing_bd",
    "object_role": "venue",
    "implied_metric": "volume",
    "examples": [
      "Robinhood sent orders to Citadel",
      "Citadel received orders from Robinhood"
    ]
  },
  "venue_to_executing_bd": {
    "verbs": ["paid", "gave", "rebated", "compensated", "credited"],
